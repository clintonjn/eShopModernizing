@model eShopNet8.MVC.Controllers.CatalogIndexViewModel
@{
    ViewData["Title"] = "Catalog Items";
}

<div class="row">
    <div class="col-md-3">
        <h4>Filters</h4>
        <form method="get">
            <div class="form-group mb-3">
                <label for="brandFilterApplied">Brand:</label>
                <select name="brandFilterApplied" class="form-control">
                    <option value="0">All Brands</option>
                    @foreach (var brand in Model.CatalogBrands)
                    {
                        <option value="@brand.Id" selected="@(brand.Id == Model.BrandFilterApplied)">@brand.Brand</option>
                    }
                </select>
            </div>
            <div class="form-group mb-3">
                <label for="typesFilterApplied">Type:</label>
                <select name="typesFilterApplied" class="form-control">
                    <option value="0">All Types</option>
                    @foreach (var type in Model.CatalogTypes)
                    {
                        <option value="@type.Id" selected="@(type.Id == Model.TypesFilterApplied)">@type.Type</option>
                    }
                </select>
            </div>
            <button type="submit" class="btn btn-primary">Filter</button>
            <a href="@Url.Action("Index")" class="btn btn-secondary">Clear</a>
        </form>
    </div>
    <div class="col-md-9">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2>Catalog Items</h2>
            <a asp-action="Create" class="btn btn-success">Add New Item</a>
        </div>

        @if (Model.CatalogItems.Any())
        {
            <div class="table-responsive">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Description</th>
                            <th>Brand</th>
                            <th>Type</th>
                            <th>Price</th>
                            <th>Stock</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.CatalogItems)
                        {
                            <tr>
                                <td>@item.Name</td>
                                <td>@item.Description</td>
                                <td>@item.CatalogBrand?.Brand</td>
                                <td>@item.CatalogType?.Type</td>
                                <td>@item.Price.ToString("C")</td>
                                <td>@item.AvailableStock</td>
                                <td>
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Details</a>
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Edit</a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Delete</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            @if (Model.PaginationInfo.TotalPages > 1)
            {
                <nav aria-label="Catalog pagination">
                    <ul class="pagination justify-content-center">
                        <li class="page-item @Model.PaginationInfo.Previous">
                            <a class="page-link" href="@Url.Action("Index", new { page = Model.PaginationInfo.ActualPage - 1, brandFilterApplied = Model.BrandFilterApplied, typesFilterApplied = Model.TypesFilterApplied })">Previous</a>
                        </li>
                        @for (int i = 0; i < Model.PaginationInfo.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.PaginationInfo.ActualPage ? "active" : "")">
                                <a class="page-link" href="@Url.Action("Index", new { page = i, brandFilterApplied = Model.BrandFilterApplied, typesFilterApplied = Model.TypesFilterApplied })">@(i + 1)</a>
                            </li>
                        }
                        <li class="page-item @Model.PaginationInfo.Next">
                            <a class="page-link" href="@Url.Action("Index", new { page = Model.PaginationInfo.ActualPage + 1, brandFilterApplied = Model.BrandFilterApplied, typesFilterApplied = Model.TypesFilterApplied })">Next</a>
                        </li>
                    </ul>
                </nav>
            }
        }
        else
        {
            <div class="alert alert-info">
                <h4>No items found</h4>
                <p>There are no catalog items matching your criteria. <a asp-action="Create">Add the first item</a>.</p>
            </div>
        }
    </div>
</div>